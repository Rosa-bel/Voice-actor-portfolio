# Contact form (Brevo transactional email). Copy to .env.local and restart `npm run dev`.
# On a host (Vercel, etc.) set the same variables in its environment settings.
# API key: Brevo > SMTP & API > API Keys
BREVO_API_KEY=
# Sender address: must be validated in Brevo (Senders, Domains & Dedicated IPs > Senders)
CONTACT_FROM=rozabelga@gmail.com
# Where inquiries are delivered (defaults to CONTACT_FROM)
CONTACT_TO=rozabelga@gmail.com
